<UserControl x:Class="RecoverX.Desktop.Views.DriveCardsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RecoverX.Desktop.Services">
    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12" BorderBrush="{DynamicResource WarningBrush}"
                Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{loc:Loc Admin_Banner}" TextWrapping="Wrap"/>
                <Button Content="{loc:Loc Admin_Restart}" Command="{Binding RestartAsAdminCommand}"
                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{loc:Loc Drives_Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>
        <TextBlock Text="{loc:Loc Drives_None}" Style="{StaticResource Muted}"
                   Visibility="{Binding HasNoDrives, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Drives}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Width="300" Margin="0,0,16,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Letter}" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Title}" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SystemBadge}" Style="{StaticResource Muted}" FontWeight="SemiBold"
                                       Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding DeviceLine}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasDevice, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding TypeLine}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding ConnectionLine}" Style="{StaticResource Muted}"/>
                            <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,10,0,0"
                                         Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource BorderBrushSoft}"
                                         BorderThickness="0"/>
                            <TextBlock Text="{Binding UsedLine}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding FreeLine}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding FileSystemLine}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding SourceLine}" Style="{StaticResource Muted}"/>
                            <Border Style="{StaticResource WarningBar}" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap"/>
                            </Border>
                            <Button Content="{loc:Loc Drive_Verify}" ToolTip="{loc:Loc Drive_Verify_Tip}"
                                    Command="{Binding DataContext.VerifyAccessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" IsEnabled="{Binding IsReady}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"/>
                            <Button Content="{loc:Loc Drive_Scan}" ToolTip="{Binding ScanTooltip}"
                                    Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" IsEnabled="{Binding CanScan}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
