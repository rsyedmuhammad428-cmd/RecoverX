<UserControl x:Class="RecoverX.Desktop.Views.ScanView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RecoverX.Desktop.Services">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Scan_Title}" Style="{StaticResource PageTitle}"/>

        <!-- Idle: nothing scanned yet (or the last attempt failed) -->
        <StackPanel Grid.Row="1" Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top">
            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource ErrorBrush}" Margin="0,8,0,12"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"/>
                    <Button Content="{loc:Loc Admin_Restart}" Command="{Binding RestartAdminCommand}" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding ShowAdminButton, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{loc:Loc Scan_Idle}" Style="{StaticResource Muted}" Margin="0,8,0,12"/>
            <Button Content="{loc:Loc Scan_GoToDrives}" Command="{Binding GoToDrivesCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Scanning -->
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,8,0,0"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding DriveTitle}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding PhaseText}" Style="{StaticResource Muted}" Margin="0,4,0,10"/>
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="10"
                             Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource BorderBrushSoft}" BorderThickness="0"/>
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding CandidatesText}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                <TextBlock Text="{loc:Loc Deep_TimeNote}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                           Visibility="{Binding IsDeep, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{loc:Loc Scan_Pause}" Command="{Binding PauseCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="{loc:Loc Scan_Resume}" Command="{Binding ResumeCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="{loc:Loc Scan_StopKeep}" Command="{Binding CancelCommand}" Style="{StaticResource PrimaryButton}" ToolTip="{loc:Loc Scan_StopKeep_Tip}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Grid Grid.Row="1" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="220"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                <ItemsControl ItemsSource="{Binding Notices}" Visibility="{Binding HasNotices, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource WarningBar}" Margin="0,0,0,4"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Search, filters, sort -->
            <WrapPanel Grid.Row="1" Margin="0,8,0,8">
                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="{loc:Loc Filter_Search}" Style="{StaticResource Muted}" FontSize="11"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" Width="200"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="{loc:Loc Filter_Type}" Style="{StaticResource Muted}" FontSize="11"/>
                    <ComboBox ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Text" Width="130" Padding="6,5"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="{loc:Loc Filter_Rating}" Style="{StaticResource Muted}" FontSize="11"/>
                    <ComboBox ItemsSource="{Binding RatingChoices}" SelectedItem="{Binding SelectedRating}" DisplayMemberPath="Text" Width="130" Padding="6,5"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="{loc:Loc Filter_Size}" Style="{StaticResource Muted}" FontSize="11"/>
                    <ComboBox ItemsSource="{Binding SizeChoices}" SelectedItem="{Binding SelectedSize}" DisplayMemberPath="Text" Width="130" Padding="6,5"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="{loc:Loc Filter_DateFrom}" Style="{StaticResource Muted}" FontSize="11"/>
                    <DatePicker SelectedDate="{Binding DateFrom}" Width="120"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="{loc:Loc Filter_DateTo}" Style="{StaticResource Muted}" FontSize="11"/>
                    <DatePicker SelectedDate="{Binding DateTo}" Width="120"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="{loc:Loc Filter_Sort}" Style="{StaticResource Muted}" FontSize="11"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Text" Width="110" Padding="6,5"/>
                        <CheckBox Content="{loc:Loc Filter_Descending}" IsChecked="{Binding SortDescending}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="{loc:Loc Filter_Reset}" Command="{Binding ResetFiltersCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
            </WrapPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                    <TextBlock Text="{Binding ShownText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="{loc:Loc Scan_SelectShown}" Command="{Binding SelectShownCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                    <Button Content="{loc:Loc Scan_SelectRecoverable}" Command="{Binding SelectExcellentCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                    <Button Content="{loc:Loc Scan_ClearSelection}" Command="{Binding ClearSelectionCommand}" Style="{StaticResource SecondaryButton}"/>
                </WrapPanel>

                <DataGrid Grid.Row="1" Grid.Column="0" Style="{StaticResource ResultsGrid}" ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding CurrentRow, Mode=TwoWay}" x:Name="Results">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="34">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                              IsEnabled="{Binding DataContext.CanEditSelection, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:Loc Scan_Col_Name}" Width="*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Entry.Path}"/>
                                        <TextBlock Text="{Binding FolderText}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11"/>
                                        <TextBlock Text="{Binding PathUncertainText}" Style="{StaticResource Muted}" FontSize="11"
                                                   Visibility="{Binding PathUncertain, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Loc Scan_Col_Type}" Binding="{Binding TypeText}" Width="60"/>
                        <DataGridTextColumn Header="{loc:Loc Scan_Col_Size}" Binding="{Binding SizeText}" Width="85"/>
                        <DataGridTextColumn Header="{loc:Loc Scan_Col_Date}" Binding="{Binding DateText}" Width="130"/>
                        <DataGridTemplateColumn Header="{loc:Loc Scan_Col_Condition}" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel ToolTip="{Binding ConditionTip}" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="{Binding RatingColor}" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding RatingText}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ConditionText}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{loc:Loc Scan_Preview}" Style="{StaticResource SecondaryButton}" Padding="8,3"
                                            Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Preview panel -->
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{loc:Loc Preview_Title}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{Binding PreviewTitle}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource WarningBar}" Visibility="{Binding HasPreviewWarning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding PreviewWarning}" TextWrapping="Wrap" FontSize="11"/>
                        </Border>
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock Text="{loc:Loc Preview_Hint}" Style="{StaticResource Muted}"
                                       Visibility="{Binding ShowPreviewHint, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding PreviewMessage}" Style="{StaticResource Muted}" Background="{DynamicResource SurfaceBrush}"
                                       Visibility="{Binding HasPreviewMessage, Converter={StaticResource BoolToVis}}"/>
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"
                                   Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVis}}"/>
                            <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                     VerticalScrollBarVisibility="Auto" Style="{StaticResource Input}"
                                     Visibility="{Binding HasPreviewText, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            
            <!-- Results of the last recovery sit beside the controls so the card never grows taller
                 and never squeezes the file list above it. -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" x:Name="RecoverControls">
                    <TextBlock Text="{Binding SelectedText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc Scan_Destination}" Margin="0,8,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" IsEnabled="{Binding CanEditSelection}"/>
                        <Button Grid.Column="1" Content="{loc:Loc Scan_Browse}" Command="{Binding BrowseCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding DestinationHint}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,6"/>
                    <CheckBox Content="{loc:Loc Scan_PreserveFolders}" IsChecked="{Binding PreserveFolders}" IsEnabled="{Binding CanEditSelection}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{loc:Loc Scan_Recover}" Command="{Binding RecoverCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                        <Button Content="{loc:Loc Scan_Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                                Visibility="{Binding IsRecovering, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="{loc:Loc Recover_OpenFolder}" Command="{Binding OpenFolderCommand}" Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsRecovering, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                        <TextBlock Text="{Binding RecoveryText}" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding RecoveryProgress, Mode=OneWay}" Height="8" Margin="0,4,0,0"
                                     Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource BorderBrushSoft}" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top" Height="{Binding ActualHeight, ElementName=RecoverControls}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding DoneText}" TextWrapping="Wrap" Margin="0,0,0,0" FontWeight="SemiBold" Visibility="{Binding HasDoneText, Converter={StaticResource BoolToVis}}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Visibility="{Binding HasOutcomes, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Outcomes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
