<UserControl x:Class="RecoverX.Desktop.Views.RecoveredFilesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RecoverX.Desktop.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{loc:Loc Rec_Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{loc:Loc Rec_Subtitle}" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="{loc:Loc Rec_Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                <Button Content="{loc:Loc Rec_Clear}" Command="{Binding ClearCommand}" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ErrorBrush}"/>
            <TextBlock Text="{loc:Loc Rec_None}" Style="{StaticResource Muted}" Visibility="{Binding HasNone, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{loc:Loc Rec_OpenFolder}" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Line}" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding SavedPath}" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
