<Window x:Class="RecoverX.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RecoverX.Desktop.Services"
        Title="{loc:Loc Window_Title}"
        Width="1200" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBrush}">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Margin="4,8,4,24">
                    <TextBlock Text="{loc:Loc App_Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="{loc:Loc App_Tagline}" FontSize="11" Style="{StaticResource Muted}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{loc:Loc App_PoweredBy}" FontSize="11"
                           Style="{StaticResource Muted}" Margin="4,12,4,0"/>
                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding DisabledReason}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" Width="26" FontSize="15"/>
                                    <TextBlock Text="{Binding Title}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="28"/>
    </Grid>
</Window>
