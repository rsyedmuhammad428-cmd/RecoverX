    <SolidColorBrush x:Key="SidebarBrush" Color="#172033"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF"/>
