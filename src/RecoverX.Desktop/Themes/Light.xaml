<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2878E5"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#EDF2F8"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#172033"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5B6577"/>
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#DDE3EC"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
</ResourceDictionary>
